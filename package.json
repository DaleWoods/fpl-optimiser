{
  "name": "fpl-optimiser",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user Fantasy Premier League optimiser: ingestion, rules engine, expected-points model and ILP squad optimisation.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "fpl": "tsx src/report/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/report/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "glpk.js": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
